rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ─────────────────────────────────────────────────────

    // Check if the request comes from a logged-in user
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the logged-in user is the owner of a specific document
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Read the caller's role from their Firestore user document
    // role can be 'user' or 'admin'
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Returns true only if the caller is signed in AND has role = 'admin'
    function isAdmin() {
      return isSignedIn() && callerRole() == 'admin';
    }

    // ── USERS COLLECTION ─────────────────────────────────────────────────────
    // Stores user profiles: name, email, role (user/admin), status (active/blocked)
    match /users/{userId} {

      // A user can only read their own profile; admins can read any profile
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());

      // A new user can create their own profile document on sign-up
      // - Doc ID must match their own UID
      // - Required fields must exist
      // - Role is always 'user' on signup (admins are assigned manually)
      allow create: if isSignedIn() && isOwner(userId)
                    && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt'])
                    && request.resource.data.role == 'user';

      // A user can only update their own displayName or photoURL
      // Admins can update anything (e.g. change role to 'admin', block a user)
      allow update: if isSignedIn() && (
          (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['displayName', 'photoURL', 'updatedAt']))
          || isAdmin()
      );

      // Only admins can delete user accounts
      allow delete: if isAdmin();
    }

    // ── COMPLAINTS COLLECTION ─────────────────────────────────────────────────
    // Stores individual complaints with AI analysis, status, timeline, notes
    match /complaints/{complaintId} {

      // A user can read only their own complaints; admins can read all
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // Any signed-in user can submit a complaint
      // - userId field must match the caller's own UID (prevents fake submissions)
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      // A user can only update their feedback (rating/comment) after resolution
      // Admins can update anything: status, notes, assignment, timeline, etc.
      allow update: if isSignedIn() && (
          (resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['userRating', 'userFeedback', 'updatedAt']))
          || isAdmin()
      );

      // Only admins can delete complaints
      allow delete: if isAdmin();
    }

    // ── CATEGORIES COLLECTION ─────────────────────────────────────────────────
    // Stores complaint categories (Water Supply, Electricity, Roads, etc.)
    match /categories/{categoryId} {

      // Any signed-in user can read categories (needed for complaint submission dropdown)
      allow read: if isSignedIn();

      // Only admins can add, edit, or delete categories
      allow write: if isAdmin();
    }

    // ── GROUP COMPLAINTS COLLECTION ───────────────────────────────────────────
    // Stores petitions: group complaints that other users can sign/support
    // Achieves "Dhamaka" status at 10+ signatures
    match /groupComplaints/{complaintId} {

      // Any signed-in user can read petitions (needed for the shared signing link)
      allow read: if isSignedIn();

      // Any signed-in user can create a petition
      // - creatorId must match the caller's UID
      allow create: if isSignedIn()
                    && request.resource.data.creatorId == request.auth.uid;

      // Two types of updates are allowed:
      // 1. Signing a petition: any user (who is NOT the creator) can add their
      //    support — but only to the supporter-related fields
      // 2. Admin update: admins can change anything (status, etc.)
      allow update: if isSignedIn() && (
          (resource.data.creatorId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['supporters', 'supporterDetails', 'supporterCount', 'isDhamaka', 'updatedAt']))
          || isAdmin()
      );

      // Only admins can delete petitions
      allow delete: if isAdmin();
    }

    // ── CATCH-ALL ─────────────────────────────────────────────────────────────
    // Deny access to any collection not explicitly listed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
